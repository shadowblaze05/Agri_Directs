# Local development defaults only. Never copy these placeholders into production.
APP_ENV=development
DATABASE_URL=sqlite:///database.db
SECRET_KEY=change-this-secret-key
JWT_SECRET=change-this-jwt-secret
APP_BASE_URL=http://localhost:5000
RATELIMIT_STORAGE_URI=memory://

# Configure SMTP to test account verification and password recovery email.
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_DEFAULT_SENDER=noreply@example.test
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_SUPPRESS_SEND=true
AGRI_DIRECT_OFFICIAL_EMAIL=

# Leave unset until creating the first administrator in a local environment.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
SUPERADMIN_USERNAME=admin

APP_ENV=development
DATABASE_URL=postgresql+psycopg2://agridirect_app:your_password@localhost:5432/AgriDirect
SLOW_QUERY_THRESHOLD_MS=500
SECRET_KEY=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_character_gmail_app_password
MAIL_DEFAULT_SENDER=your_email@gmail.com
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_SUPPRESS_SEND=false
APP_BASE_URL=http://localhost:5000
# Use a shared Redis instance in production; memory:// is development-only.
RATELIMIT_STORAGE_URI=memory://
# Baseline limit per client IP across application routes. Auth endpoints have stricter limits.
RATELIMIT_DEFAULT=600 per hour
JWT_SECRET=
POSTGRES_USER=agridirect_app
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=AgriDirect
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
